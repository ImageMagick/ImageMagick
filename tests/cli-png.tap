#  limitations under the License.
#
#  Regression tests for PNG.
#
. ./common.shi
. ${srcdir}/tests/common.shi
if ! ${MAGICK} -list format | grep -E '^[[:space:]]*PNG\*?[[:space:]]+(PNG[[:space:]]+)?rw' >/dev/null; then
  echo "1..0 # SKIP PNG coder unavailable"
  exit 0
fi
echo "1..1"

# A 1-bit palette PNG still has 8-bit palette colors.
${MAGICK} -size 1x1 xc:'rgb(200,30,30)' xc:white +append \
  -define png:bit-depth=1 -define png:color-type=3 png_palette_out.png &&
  ${MAGICK} png_palette_out.png png_palette_out.ppm &&
  actual=$(${MAGICK} png_palette_out.ppm -format '%[pixel:p{0,0}]' info:) &&
  [ "$actual" = "srgb(200,30,30)" ] && echo "ok" || {
    echo "not ok"
    echo "# expected 'srgb(200,30,30)', got '$actual'"
  }

rm -f png_palette_out.png png_palette_out.ppm
:
