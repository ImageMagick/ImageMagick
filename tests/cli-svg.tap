#    https://imagemagick.org/license/
#
#  Unless required by applicable law or agreed to in writing, software
#  distributed under the License is distributed on an "AS IS" BASIS,
#  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
#  See the License for the specific language governing permissions and
#  limitations under the License.
#
#  Regression tests for SVG coder.
#
. ./common.shi
. ${srcdir}/tests/common.shi
echo "1..6"

# gradientTransform should not cause a double-free / SIGABRT (#8582)
${MAGICK} ${SRCDIR}/input_svg_gradient_transform.svg null: && echo "ok" || echo "not ok"

# Inline styles override presentation attributes regardless of attribute order.
msvg_mode=`${MAGICK} -list format | awk '$1 ~ /^MSVG/ { print $2 }'`
case "$msvg_mode" in
  *r*)
    colors=`${MAGICK} MSVG:${SRCDIR}/input_svg_inline_style.svg \
      -format '%[fx:int(255*p{5,5}.r+0.5)],%[fx:int(255*p{5,5}.g+0.5)],%[fx:int(255*p{5,5}.b+0.5)] %[fx:int(255*p{15,5}.r+0.5)],%[fx:int(255*p{15,5}.g+0.5)],%[fx:int(255*p{15,5}.b+0.5)]' info:-`
    [ "X$colors" = "X255,255,255 255,255,255" ] && echo "ok" || echo "not ok"
    ;;
  *) echo "ok # SKIP MSVG coder unavailable" ;;
esac

# MVG comments written to the SVG <desc> element must be XML escaped.
svg=`printf '%s\n' 'viewbox 0 0 4 4' '#x(<script>)' |
  ${MAGICK} MVG:- SVG:- 2>/dev/null`
case "$svg" in
  *'<desc>x(&lt;script&gt;)</desc>'*) echo "ok" ;;
  *) echo "not ok" ;;
esac

# Arc flags are single digits and need not be followed by a separator (#9092).
compact=`${MAGICK} -size 24x24 xc:white -fill none -stroke black \
  -draw "path 'M6 12h9a4 4 0 010 8H7a1 1 0 01-1-1V5a1 1 0 011-1h7a4 4 0 010 8'" \
  -format '%#' info:- 2>/dev/null`
spaced=`${MAGICK} -size 24x24 xc:white -fill none -stroke black \
  -draw "path 'M6 12 h9 a4 4 0 0 1 0 8 H7 a1 1 0 0 1 -1 -1 V5 a1 1 0 0 1 1 -1 h7 a4 4 0 0 1 0 8'" \
  -format '%#' info:- 2>/dev/null`
[ "X$compact" != "X" ] && [ "X$compact" = "X$spaced" ] && echo "ok" || echo "not ok"

# Font families are separated by commas and their names may contain spaces.
family=`${MAGICK} -list font | sed -n 's/^ *family: \([A-Za-z0-9]* [A-Za-z0-9 ]*\)$/\1/p' | head -n 1`
case "$msvg_mode:$family" in
  *r*:?*)
    single=`printf '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="40"><text x="5" y="30" font-family="%s" font-size="24">ACME</text></svg>' "$family" |
      ${MAGICK} MSVG:- -format '%#' info:- 2>/dev/null`
    list=`printf '<svg xmlns="http://www.w3.org/2000/svg" width="120" height="40"><text x="5" y="30" font-family="%s, serif" font-size="24">ACME</text></svg>' "$family" |
      ${MAGICK} MSVG:- -format '%#' info:- 2>/dev/null`
    [ "X$single" != "X" ] && [ "X$single" = "X$list" ] && echo "ok" || echo "not ok"
    ;;
  *) echo "ok # SKIP MSVG coder or a font family with a space unavailable" ;;
esac
# The natural size of a document read with librsvg 2.52 or newer, without the
# deprecated rsvg_handle_get_dimensions() (#7018).
rsvg_mode=`${MAGICK} -list format | awk '$1 ~ /^RSVG/ { print $2 }'`
rsvg_version=`${MAGICK} -list format | sed -n 's/^ *RSVG.*(RSVG \([0-9.]*\)).*$/\1/p'`
case "$rsvg_mode:$rsvg_version" in
  *r*:2.5[2-9]*|*r*:2.[6-9][0-9]*|*r*:[3-9].*)
    sizes=''
    for attributes in 'width="64" height="48"' 'width="1in" height="0.5in"' \
      'viewBox="0 0 80 50"' 'height="50" viewBox="0 0 100 200"' \
      'width="120" height="100%" viewBox="0 0 80 50"' '' \
      'width="10.4" height="10.6"'; do
      size=`printf '<svg xmlns="http://www.w3.org/2000/svg" %s><rect width="10" height="10"/></svg>' "$attributes" |
        ${MAGICK} -density 96 RSVG:- -format '%wx%h' info:- 2>/dev/null`
      sizes="$sizes $size"
    done
    [ "X$sizes" = "X 64x48 96x48 80x50 25x50 120x75 10x10 10x11" ] && echo "ok" || echo "not ok"
    ;;
  *) echo "ok # SKIP RSVG coder 2.52 or newer unavailable" ;;
esac
:
