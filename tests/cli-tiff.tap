#  limitations under the License.
#
#  Regression tests for TIFF.
#
. ./common.shi
. ${srcdir}/tests/common.shi
if ! ${MAGICK} -list format | grep -E '^[[:space:]]*TIFF\*?[[:space:]]+(TIFF[[:space:]]+)?rw' >/dev/null; then
  echo "1..0 # SKIP TIFF coder unavailable"
  exit 0
fi
echo "1..1"

${MAGICK} -size 100x100 xc:white -alpha set -colorspace gray \
  -threshold 50% -compress group4 tiff_group4_alpha.tiff &&
  actual=$(${IDENTIFY} -format "%C %A" tiff_group4_alpha.tiff) &&
  [ "$actual" = "Group4 Undefined" ] && echo "ok" || {
    echo "not ok"
    echo "# expected 'Group4 Undefined', got '$actual'"
  }

rm -f tiff_group4_alpha.tiff
:
