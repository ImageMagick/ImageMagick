#
#  Regression tests for the fx expression language.
#
. ./common.shi
. ${srcdir}/tests/common.shi
echo "1..3"

# do() iterates while the condition is not zero.
result=`${MAGICK} -limit time 10 xc: -format '%[fx:ii=-2;do(ii+=1,ii<3);ii]' info:-`
[ "X$result" = "X3" ] && echo "ok" || echo "not ok"

# do() ends even though the statements are never zero.
result=`${MAGICK} -limit time 10 xc: -format '%[fx:ii=0;do(ii+=1,ii<3);ii]' info:-`
[ "X$result" = "X3" ] && echo "ok" || echo "not ok"

# do() runs the statements once before testing the condition.
result=`${MAGICK} -limit time 10 xc: -format '%[fx:ii=5;do(ii+=1,ii<3);ii]' info:-`
[ "X$result" = "X6" ] && echo "ok" || echo "not ok"
:
