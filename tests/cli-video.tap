#
#  Regression tests for the video coder.
#
. ./common.shi
. ${srcdir}/tests/common.shi
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "1..0 # SKIP ffmpeg unavailable"
  exit 0
fi
echo "1..1"

# APNG is lossless, so the frames must not pass through a lossy intermediate.
${MAGICK} -size 64x64 gradient:red-blue -fill white -draw 'circle 32,32 32,20' \
  video_apng_out.png &&
  ${MAGICK} video_apng_out.png video_apng_out.apng &&
  actual=$(${MAGICK} compare -metric AE video_apng_out.png video_apng_out.apng \
    null: 2>&1) ;
[ "$actual" = "0 (0)" ] && echo "ok" || {
  echo "not ok"
  echo "# expected '0 (0)', got '$actual'"
}

rm -f video_apng_out.png video_apng_out.apng
:
