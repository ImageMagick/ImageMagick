. ./common.shi
. ${srcdir}/tests/common.shi

actual=resize-filter-pixels.out
reference="${SRCDIR}/resize-filter-pixels.q16.txt"
rm -f "${actual}"

./resize-filter-pixels "${actual}" "${reference}"
status=$?
if [ "${status}" -eq 77 ]; then
  echo "1..0 # SKIP Q16 non-HDRI build required"
  exit 0
fi

echo "1..1"
if [ "${status}" -eq 0 ]; then
  echo "ok"
else
  echo "not ok"
  echo "# resize filter pixels differ from the Q16 reference"
fi
:
