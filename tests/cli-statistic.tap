#
#  Regression tests for neighborhood statistics.
#
. ./common.shi
. ${srcdir}/tests/common.shi
echo "1..4"

# A black-and-white neighborhood has full contrast.
result=`${MAGICK} -size 3x1 xc:black -fill white -draw 'point 1,0' \
  -alpha off -statistic Contrast 3x1 -format '%[fx:abs(mean-1)<0.005]' info:-`
[ "X$result" = "X1" ] && echo "ok" || echo "not ok"

# Contrast is calculated and scaled separately for each color channel.
result=`${MAGICK} -size 3x1 'xc:rgb(0,85,255)' -fill white \
  -draw 'point 1,0' -alpha off -statistic Contrast 3x1 \
  -format '%[fx:abs(r-1)<0.005],%[fx:abs(g-0.5)<0.005],%[fx:abs(b)<0.005]' info:-`
[ "X$result" = "X1,1,1" ] && echo "ok" || echo "not ok"

# Uniform nonzero neighborhoods have zero contrast.
result=`${MAGICK} -size 3x1 'xc:rgb(85,85,85)' -alpha off \
  -statistic Contrast 3x1 -format '%[fx:mean==0]' info:-`
[ "X$result" = "X1" ] && echo "ok" || echo "not ok"

# An all-black neighborhood also has zero contrast.
result=`${MAGICK} -size 3x1 xc:black -alpha off -statistic Contrast 3x1 \
  -format '%[fx:mean==0]' info:-`
[ "X$result" = "X1" ] && echo "ok" || echo "not ok"
:
