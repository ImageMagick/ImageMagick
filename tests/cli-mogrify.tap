#  limitations under the License.
#
#  Regression tests for mogrify.
#
. ./common.shi
. ${srcdir}/tests/common.shi
echo "1..2"

dir=mogrify_format_dir
rm -rf "$dir" mogrify_format_plain.bmp mogrify_format_gzip.bmp
mkdir "$dir" || exit 1

# -format writes the new file next to the input.
${MAGICK} -size 2x2 xc:red "$dir/mogrify_format_plain.ppm" && \
  ${MAGICK} mogrify -format bmp "$dir/mogrify_format_plain.ppm" && \
  [ -f "$dir/mogrify_format_plain.bmp" ] && \
  [ ! -f mogrify_format_plain.bmp ] && echo "ok" || echo "not ok"

# The same holds when the input carries a compression extension.
${MAGICK} -size 2x2 xc:red "$dir/mogrify_format_gzip.ppm.gz" && \
  ${MAGICK} mogrify -format bmp "$dir/mogrify_format_gzip.ppm.gz" && \
  [ -f "$dir/mogrify_format_gzip.bmp" ] && \
  [ ! -f mogrify_format_gzip.bmp ] && echo "ok" || echo "not ok"

rm -rf "$dir" mogrify_format_plain.bmp mogrify_format_gzip.bmp
:
